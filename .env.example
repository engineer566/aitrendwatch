# ---------- 必设（生产）----------
SECRET_KEY=changeme-请改成一段随机长串
ADMIN_TOKEN=changeme-管理后台令牌，未设则 /admin 隐身 404

# ---------- DeepSeek LLM（维度热词打标）----------
# 未配置 → dims.py 降级到 RSS 源默认维度，热词仍可展示但无 LLM 摘要/精确分类
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# ---------- 站点 ----------
SITE_NAME=ModelRadar
BASE_URL=https://your-domain.com

# ---------- SEO ----------
# 关闭则不输出 canonical/OG/JSON-LD，robots 禁止索引
SEO_ENABLED=true
# sitemap.xml 最多 URL 条数
SITEMAP_MAX_URLS=200
# 单热词详情页进程内缓存 TTL（秒）
TERM_DETAIL_CACHE_TTL=1800

# ---------- Google AdSense（未备案也能申请）----------
# 1. 注册 https://www.google.com/adsense/start/ 添加站点
# 2. 把给的 ca-pub-xxxxxxxxxxxxxxxx 填到 ADSENSE_CLIENT
# 3. 开 ADSENSE_ENABLED=true 让脚本上线（审核需脚本已部署）
ADSENSE_ENABLED=false
ADSENSE_CLIENT=

# ---------- 百度联盟（硬门槛：先 ICP 备案）----------
# 1. 域名 ICP 备案（云服务商提交，1-3 周）
# 2. 备案通过后注册 https://union.baidu.com/ 提交站点审核
# 3. 新建广告位拿 cpro_id 填到 BAIDU_ADS_CPRO_ID
BAIDU_ADS_ENABLED=false
BAIDU_ADS_CPRO_ID=

# ---------- 流量监控：IP 地域兜底（可选）----------
# 监控页（/monitor，仅管理员）统计访问量 + 独立 IP + 地域分布。
# 地域判定优先用反代头（CF-IPCountry / X-Country-Code，前置 Cloudflare 或
# 带 ngx_http_geoip2_module 的 Nginx 会自动注入）；无头时用本地 GeoLite2 兜底。
# GeoLite2-Country.mmdb 放到 data/ 目录（容器内 /app/data/）即默认路径，缺失时
# 地域一律显示 Unknown，站点正常运行。
# 获取：https://www.maxmind.com 免费注册 license key 下载 GeoLite2-Country。
# GEOIP_DB_PATH=/app/data/GeoLite2-Country.mmdb
