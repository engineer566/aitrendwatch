# ---------- 必设（生产）----------
SECRET_KEY=changeme-请改成一段随机长串
ADMIN_TOKEN=changeme-管理后台令牌，未设则 /admin 隐身 404

# ---------- 站点 ----------
SITE_NAME=ModelRadar
BASE_URL=https://your-domain.com

# ---------- Google AdSense（未备案也能申请）----------
# 1. 注册 https://www.google.com/adsense/start/ 添加站点
# 2. 把给的 ca-pub-xxxxxxxxxxxxxxxx 填到 ADSENSE_CLIENT
# 3. 开 ADSENSE_ENABLED=true 让脚本上线（审核需脚本已部署）
ADSENSE_ENABLED=false
ADSENSE_CLIENT=

# ---------- 百度联盟（硬门槛：先 ICP 备案）----------
# 1. 域名 ICP 备案（云服务商提交，1-3 周）
# 2. 备案通过后注册 https://union.baidu.com/ 提交站点审核
# 3. 新建广告位拿 cpro_id 填到 BAIDU_ADS_CPRO_ID
BAIDU_ADS_ENABLED=false
BAIDU_ADS_CPRO_ID=
